# 3 つとも環境変数でも渡せる。ファイルに書くならこの名前で .env に（Git 管理外）
TYPESAFE_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=            # GOOGLE_API_KEY という名前でも読む
# 任意
# LLM_MODEL=claude-opus-5        # 台詞と LLM 側の判定。claude-haiku-4-5 / claude-sonnet-5 も可
# TTS_MODEL=gemini-3.8-flash-tts     # 安くするなら gemini-3.8-flash-lite-tts
# TTS_VOICE=Leda                     # 既製の名前か、node design_voice.mjs --preset で自分のプロジェクトに作った voice_… の ID。
#                                    # 未指定なら scenario.json の声（作者のプロジェクトで設計した声）。別の鍵では使えないので既製の Leda に自動で切り替わる
# TTS_FALLBACK_VOICE=Leda            # その切り替え先
# PORT=8792
# REFLEX_GALGE_OUT=_out          # ログの出力先

# 声の中継（どちらか一方）
# VOICE_RELAY_URL=https://xxxx.a.run.app   # 遊ぶ側: 声を作者の中継サーバーに頼む（GEMINI_API_KEY は不要。声は作者の設計した声のまま）
# RELAY_TOKEN=                             # 中継に合言葉があるとき（両側に同じ値）
# VOICE_RELAY=1                            # 中継側: この起動を中継サーバーにする（GEMINI_API_KEY と TTS_VOICE を持つ。Jev・Claude・画面は出さない）
# RELAY_PER_IP_10MIN=40                    # 中継側: 1 人（IP）あたり 10 分の回数
# RELAY_DAILY_CAP=3000                     # 中継側: 全体の 1 日の回数
# TRUST_PROXY_HOPS=1                       # 公開・中継: 相手の IP は X-Forwarded-For の後ろから何番目か（手前の中継の数。起動ログの段数を見て合わせる）

# 置き方
# HOST=0.0.0.0            # 同じ Wi-Fi のスマホから遊ぶ（起動時に URL が出る）。既定は 127.0.0.1（自分の PC だけ）
# PUBLIC=1                # 公開サーバーとして置く（言葉の生成を「手」として 1 人・全体で数える。RELAY_PER_IP_10MIN=30 / RELAY_DAILY_CAP=400）
#                         # 声は別に数える（VOICE_PER_IP_10MIN=40 / VOICE_DAILY_CAP=800）。計測（_out/turns.jsonl）は残さない
